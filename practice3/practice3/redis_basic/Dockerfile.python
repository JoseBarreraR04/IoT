FROM ubuntu:22.04

# Evitar prompts interactivos de apt
ENV DEBIAN_FRONTEND=noninteractive

# Instalar Python 3, el módulo venv, pip y curl
RUN apt-get update && \
    apt-get install -y python3 python3-venv python3-pip curl && \
    rm -rf /var/lib/apt/lists/*

# Instalar uv globalmente a través de pip
RUN pip3 install uv

WORKDIR /app
